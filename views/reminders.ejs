<%- include('partials/layout-start', { active, searchQuery }) %>
<section class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm mb-4">
  <div class="flex items-center justify-between mb-2">
    <h2 class="font-semibold">Nuovo promemoria</h2>
    <span class="text-xs text-slate-500">rapido da dashboard</span>
  </div>
  <form action="/reminders" method="post" class="grid md:grid-cols-3 gap-3">
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-slate-600">Titolo</label>
      <input name="title" required class="rounded border border-slate-200 px-3 py-2 w-full">
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-slate-600">Quando (opz.)</label>
      <input name="remind_at" type="datetime-local" class="rounded border border-slate-200 px-3 py-2 w-full">
    </div>
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-slate-600">Tag</label>
      <input name="tags" class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="#tag">
    </div>
    <div class="flex md:col-span-3 justify-end">
      <button class="px-4 py-2 rounded bg-ink text-white w-full sm:w-auto">Salva</button>
    </div>
  </form>
</section>

<section class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
  <div class="flex items-center justify-between mb-3">
    <h2 class="font-semibold">Promemoria</h2>
    <div class="flex gap-2">
      <a href="/reminders?view=today" class="px-3 py-2 rounded border <%= view==='today' ? 'bg-slate-900 text-white border-slate-900' : 'border-slate-200' %>">Oggi</a>
      <a href="/reminders?view=next" class="px-3 py-2 rounded border <%= view==='next' ? 'bg-slate-900 text-white border-slate-900' : 'border-slate-200' %>">Prossimi 7g</a>
      <a href="/reminders" class="px-3 py-2 rounded border <%= view!=='today' && view!=='next' ? 'bg-slate-900 text-white border-slate-900' : 'border-slate-200' %>">Tutti</a>
    </div>
  </div>

  <% if (reminders.length === 0) { %>
    <p class="text-slate-500 text-sm">Niente da ricordare. Aggiungi un promemoria con il form sopra.</p>
  <% } else { %>
    <div class="space-y-3">
      <% reminders.forEach(r => { %>
        <article id="reminder-<%= r.id %>" class="border border-slate-200 rounded-lg p-3 flex flex-col gap-2">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-semibold <%= r.done ? 'line-through text-slate-500' : '' %>"><%= r.title %></p>
              <p class="text-xs text-slate-500">Quando: <%= r.remind_at ? new Date(r.remind_at).toLocaleString() : 'libero' %></p>
              <p class="text-xs text-slate-500">Tag: <%= r.tags || '—' %></p>
            </div>
            <div class="flex gap-2 items-center">
              <form action="/reminders/<%= r.id %>/toggle" method="post">
                <button class="text-xs px-3 py-2 rounded border <%= r.done ? 'border-emerald-500 text-emerald-700' : 'border-slate-300' %>"><%= r.done ? 'Riapri' : 'Fatto' %></button>
              </form>
              <form action="/reminders/<%= r.id %>/delete" method="post" onsubmit="return confirm('Eliminare?')">
                <button class="text-xs px-3 py-2 rounded bg-red-50 text-red-700 border border-red-200">X</button>
              </form>
            </div>
          </div>
          <details>
            <summary class="text-sm text-slate-600 cursor-pointer py-1">Modifica</summary>
            <form action="/reminders/<%= r.id %>/update" method="post" class="mt-2 grid md:grid-cols-2 gap-2">
              <div class="flex flex-col gap-1 md:col-span-2">
                <label class="text-xs font-semibold text-slate-600">Titolo</label>
                <input name="title" value="<%= r.title %>" class="rounded border border-slate-200 px-2 py-2 w-full" required>
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-600">Quando</label>
                <input name="remind_at" type="datetime-local" value="<%= r.remind_at ? new Date(r.remind_at).toISOString().slice(0,16) : '' %>" class="rounded border border-slate-200 px-2 py-2 w-full">
              </div>
              <label class="flex items-center gap-2 text-sm">
                <input type="checkbox" name="done" value="1" <%= r.done ? 'checked' : '' %>> fatto
              </label>
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-600">Tag</label>
                <input name="tags" value="<%= r.tags || '' %>" class="rounded border border-slate-200 px-2 py-2 w-full" placeholder="#tag">
              </div>
              <div class="md:col-span-2 flex flex-col sm:flex-row gap-2 sm:justify-end">
                <button class="px-3 py-2 rounded bg-ink text-white w-full sm:w-auto">Aggiorna</button>
              </div>
            </form>
          </details>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/layout-end') %>
