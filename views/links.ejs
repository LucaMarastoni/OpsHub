<%- include('partials/layout-start', { active, searchQuery }) %>
<section class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm mb-4">
  <div class="flex items-center justify-between mb-2">
    <h2 class="font-semibold">Salva link</h2>
    <span class="text-xs text-slate-500">auto titolo se vuoto</span>
  </div>
  <form action="/links" method="post" class="grid md:grid-cols-2 gap-3">
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-slate-600">URL</label>
      <input name="url" required class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="https://">
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-slate-600">Titolo (opz.)</label>
      <input name="title" class="rounded border border-slate-200 px-3 py-2 w-full">
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-slate-600">Tag</label>
      <input name="tags" class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="#tag">
    </div>
    <div class="flex flex-col gap-1 md:col-span-2">
      <label class="text-xs font-semibold text-slate-600">Nota</label>
      <textarea name="note" rows="2" class="rounded border border-slate-200 px-3 py-2 w-full"></textarea>
    </div>
    <div class="md:col-span-2 flex justify-end">
      <button class="px-4 py-2 rounded bg-ink text-white w-full sm:w-auto">Salva</button>
    </div>
  </form>
</section>

<section class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
  <div class="flex items-center justify-between mb-3">
    <h2 class="font-semibold">Link</h2>
    <form class="flex flex-col sm:flex-row gap-2 w-full" method="get" action="/links">
      <label class="text-xs font-semibold text-slate-600 w-full sm:w-48">Testo
        <input name="q" value="<%= filters.q||'' %>" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full">
      </label>
      <label class="text-xs font-semibold text-slate-600 w-full sm:w-32">Tag
        <input name="tag" value="<%= filters.tag||'' %>" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full">
      </label>
      <button class="px-3 py-2 rounded bg-slate-900 text-white text-sm w-full sm:w-auto self-end sm:self-auto">Filtra</button>
    </form>
  </div>
  <% if (links.length === 0) { %>
    <p class="text-slate-500 text-sm">Ancora nessun link. Salva il primo con il form sopra.</p>
  <% } else { %>
    <div class="space-y-3">
      <% links.forEach(l => { %>
        <article id="link-<%= l.id %>" class="border border-slate-200 rounded-lg p-3">
          <div class="flex items-start justify-between gap-2">
            <div>
              <a href="<%= l.url %>" target="_blank" rel="noreferrer" class="font-semibold text-sky-700 block truncate"><%= l.title || l.url %></a>
              <p class="text-xs text-slate-500 truncate"><%= l.url %></p>
              <p class="text-xs text-slate-500">Tag: <%= l.tags || '—' %></p>
              <% if (l.note) { %>
                <p class="text-sm text-slate-700 mt-1"><%= l.note %></p>
              <% } %>
            </div>
            <form action="/links/<%= l.id %>/delete" method="post" onsubmit="return confirm('Eliminare?')">
              <button class="text-xs px-3 py-2 rounded bg-red-50 text-red-700 border border-red-200">X</button>
            </form>
          </div>
          <details class="mt-2">
            <summary class="text-sm text-slate-600 cursor-pointer py-1">Modifica</summary>
            <form action="/links/<%= l.id %>/update" method="post" class="mt-2 grid md:grid-cols-2 gap-2">
              <div class="flex flex-col gap-1 md:col-span-2">
                <label class="text-xs font-semibold text-slate-600">URL</label>
                <input name="url" value="<%= l.url %>" class="rounded border border-slate-200 px-2 py-2 w-full" required>
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-600">Titolo</label>
                <input name="title" value="<%= l.title || '' %>" class="rounded border border-slate-200 px-2 py-2 w-full">
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-600">Tag</label>
                <input name="tags" value="<%= l.tags || '' %>" class="rounded border border-slate-200 px-2 py-2 w-full">
              </div>
              <div class="flex flex-col gap-1 md:col-span-2">
                <label class="text-xs font-semibold text-slate-600">Nota</label>
                <textarea name="note" rows="2" class="rounded border border-slate-200 px-2 py-2 w-full"><%= l.note || '' %></textarea>
              </div>
              <div class="md:col-span-2 flex flex-col sm:flex-row gap-2 sm:justify-end">
                <button class="px-3 py-2 rounded bg-ink text-white w-full sm:w-auto">Aggiorna</button>
              </div>
            </form>
          </details>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/layout-end') %>
