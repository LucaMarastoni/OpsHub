<%- include('partials/layout-start', { active, searchQuery }) %>
<section id="new" class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm mb-4">
  <div class="flex items-center justify-between mb-2">
    <h2 class="font-semibold">Nuova nota</h2>
    <span class="text-xs text-slate-500">scorciatoia: "n"</span>
  </div>
  <form action="/notes" method="post" class="space-y-3">
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-slate-600">Titolo</label>
      <input name="title" required class="rounded border border-slate-200 px-3 py-2 w-full">
    </div>
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-slate-600">Contenuto (markdown)</label>
      <textarea name="body_md" rows="4" class="rounded border border-slate-200 px-3 py-2 w-full"></textarea>
    </div>
    <div class="flex flex-col sm:flex-row gap-2 items-start sm:items-end">
      <div class="flex flex-col gap-1 w-full sm:w-auto sm:flex-1">
        <label class="text-xs font-semibold text-slate-600">Tag</label>
        <input name="tags" class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="#tag">
      </div>
      <button class="px-4 py-2 rounded bg-ink text-white w-full sm:w-auto">Salva</button>
    </div>
  </form>
</section>

<section class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
  <div class="flex items-center justify-between mb-3">
    <h2 class="font-semibold">Note</h2>
    <form class="flex flex-col sm:flex-row gap-2 w-full" method="get" action="/notes">
      <label class="text-xs font-semibold text-slate-600 w-full sm:w-48">Testo
        <input name="q" value="<%= filters.q||'' %>" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full">
      </label>
      <label class="text-xs font-semibold text-slate-600 w-full sm:w-32">Tag
        <input name="tag" value="<%= filters.tag||'' %>" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full">
      </label>
      <button class="px-3 py-2 rounded bg-slate-900 text-white text-sm w-full sm:w-auto self-end sm:self-auto">Filtra</button>
    </form>
  </div>

  <% if (notes.length === 0) { %>
    <p class="text-slate-500 text-sm">Nessuna nota trovata. Aggiungi la tua prima nota con il form sopra.</p>
  <% } else { %>
    <div class="space-y-3">
      <% notes.forEach(n => { %>
        <article id="note-<%= n.id %>" class="border border-slate-200 rounded-lg p-3">
          <div class="flex items-start justify-between gap-2">
            <div>
              <p class="font-semibold"><%= n.title %></p>
              <p class="text-xs text-slate-500">Aggiornata: <%= new Date(n.updated_at).toLocaleString() %></p>
            </div>
            <form method="post" action="/notes/<%= n.id %>/delete" onsubmit="return confirm('Eliminare?')">
              <button class="text-xs px-3 py-2 rounded bg-red-50 text-red-700 border border-red-200">Elimina</button>
            </form>
          </div>
          <div class="text-sm leading-relaxed text-slate-800 mt-2"><%- n.body_html || '<p class="text-slate-500">(vuota)</p>' %></div>
          <p class="text-xs text-slate-500 mt-2">Tag: <%= n.tags || '—' %></p>
          <details class="mt-2">
            <summary class="text-sm text-slate-600 cursor-pointer py-1">Modifica</summary>
            <form action="/notes/<%= n.id %>/update" method="post" class="mt-2 space-y-2">
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-600">Titolo</label>
                <input name="title" value="<%= n.title %>" class="rounded border border-slate-200 px-2 py-2 w-full" required>
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-600">Contenuto</label>
                <textarea name="body_md" rows="4" class="rounded border border-slate-200 px-2 py-2 w-full"><%= n.body_md || '' %></textarea>
              </div>
              <div class="flex flex-col gap-1">
                <label class="text-xs font-semibold text-slate-600">Tag</label>
                <input name="tags" value="<%= n.tags || '' %>" class="rounded border border-slate-200 px-2 py-2 w-full" placeholder="#tag">
              </div>
              <button class="px-3 py-2 rounded bg-ink text-white w-full sm:w-auto">Aggiorna</button>
            </form>
          </details>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/layout-end') %>
