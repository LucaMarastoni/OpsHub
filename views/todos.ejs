<%- include('partials/layout-start', { active, searchQuery }) %>
<section id="new" class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm mb-5">
  <div class="flex items-center justify-between mb-3">
    <h2 class="font-semibold">Nuovo task</h2>
    <span class="text-xs text-slate-500">tasto rapido: "t"</span>
  </div>
  <form action="/todos" method="post" class="flex flex-col gap-3" id="todo-form">
    <!-- Riga 1: titolo / scadenza / priorità -->
    <div class="grid md:grid-cols-[1.5fr_1fr_0.8fr] gap-3">
      <div class="flex flex-col gap-1">
        <label class="text-xs font-semibold text-slate-600">Titolo</label>
        <input name="title" required class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="Titolo del task">
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-xs font-semibold text-slate-600">Scadenza</label>
        <input name="due_date" type="datetime-local" class="rounded border border-slate-200 px-3 py-2 w-full">
      </div>
      <div class="flex flex-col gap-1">
        <label class="text-xs font-semibold text-slate-600">Priorità</label>
        <select name="priority" class="rounded border border-slate-200 px-3 py-2 w-full">
          <option value="high">Alta</option>
          <option value="med" selected>Media</option>
          <option value="low">Bassa</option>
        </select>
      </div>
    </div>

    <!-- Riga 2: descrizione -->
    <div class="flex flex-col gap-1">
      <label class="text-xs font-semibold text-slate-600">Descrizione (markdown)</label>
      <textarea name="description" rows="2" class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="Dettagli sintetici"></textarea>
    </div>

    <!-- Riga 3: stato + tag -->
    <div class="flex flex-col gap-3 md:grid md:grid-cols-[240px_1fr] md:items-start">
      <div class="flex flex-col gap-1">
        <label class="text-xs font-semibold text-slate-600">Stato</label>
        <select name="status" class="rounded border border-slate-200 px-3 py-2 w-full">
          <option value="todo">Da fare</option>
          <option value="doing">In corso</option>
          <option value="done">Fatto</option>
        </select>
      </div>
      <div class="flex flex-col gap-1 min-w-0">
        <label class="text-xs font-semibold text-slate-600">Tag</label>
        <textarea
          name="tags"
          rows="1"
          class="rounded border border-slate-200 px-3 py-2 w-full h-[44px] min-h-[44px] max-h-[80px] resize-y md:resize-none"
          placeholder="#tag1, tag2"></textarea>
      </div>
    </div>

    <!-- Riga 4: ricorrenza -->
    <div class="flex flex-col gap-2">
      <label class="inline-flex items-center gap-2 text-sm font-medium text-slate-700">
        <input type="checkbox" name="recurring" id="recurring-toggle" class="rounded border-slate-300">
        Ricorrente
      </label>

      <div class="grid md:grid-cols-12 gap-3 bg-slate-50 border border-slate-200 rounded-lg p-3 hidden" id="recurring-fields">
        <div class="md:col-span-3 flex flex-col gap-1">
          <label class="text-xs font-semibold text-slate-600">Data inizio</label>
          <input type="date" name="start_date" class="rounded border border-slate-200 px-3 py-2 w-full" value="<%= dayjs().format('YYYY-MM-DD') %>">
        </div>
        <div class="md:col-span-3 flex flex-col gap-1">
          <label class="text-xs font-semibold text-slate-600">Data fine</label>
          <input type="date" name="end_date" class="rounded border border-slate-200 px-3 py-2 w-full" value="<%= dayjs().add(10,'day').format('YYYY-MM-DD') %>">
          <p class="text-xs text-slate-500">In alternativa indica i giorni sotto.</p>
        </div>
        <div class="md:col-span-2 flex flex-col gap-1">
          <label class="text-xs font-semibold text-slate-600">Durata giorni</label>
          <input type="number" min="1" max="90" name="total_days" class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="10">
        </div>
        <div class="md:col-span-4 flex flex-col gap-1">
          <label class="text-xs font-semibold text-slate-600">Ripeti N volte al giorno</label>
          <input type="number" min="1" max="12" name="repeats_per_day" class="rounded border border-slate-200 px-3 py-2 w-full" value="1">
        </div>
        <div class="md:col-span-6 flex flex-col gap-1">
          <label class="text-xs font-semibold text-slate-600">Range orario (opzionale)</label>
          <div class="flex gap-2">
            <input type="time" name="wake_start" class="rounded border border-slate-200 px-3 py-2 w-full" value="09:00">
            <input type="time" name="wake_end" class="rounded border border-slate-200 px-3 py-2 w-full" value="21:00">
          </div>
          <p class="text-xs text-slate-500">Usato se non indichi orari manuali.</p>
        </div>
        <div class="md:col-span-6 flex flex-col gap-1">
          <label class="text-xs font-semibold text-slate-600">Orari manuali (HH:MM, virgola)</label>
          <input type="text" name="custom_times" class="rounded border border-slate-200 px-3 py-2 w-full" placeholder="09:00, 12:00, 18:00">
          <p class="text-xs text-slate-500">Se valorizzato, sovrascrive il range.</p>
        </div>
      </div>
    </div>

    <!-- Riga 5: azione -->
    <div class="flex justify-end">
      <button class="px-4 py-2 rounded bg-ink text-white w-full sm:w-auto">Salva</button>
    </div>
  </form>
</section>

<section class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
  <div class="flex flex-col gap-3 mb-3">
    <div class="flex items-center justify-between">
      <h2 class="font-semibold">Todo</h2>
    </div>
    <form class="grid md:grid-cols-12 gap-2 items-end" method="get" action="/todos">
      <label class="text-xs font-semibold text-slate-600 md:col-span-3">Stato
        <select name="status" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full">
          <option value="">Tutti</option>
          <option value="todo" <%= filters.status==='todo'?'selected':'' %>>Da fare</option>
          <option value="doing" <%= filters.status==='doing'?'selected':'' %>>In corso</option>
          <option value="done" <%= filters.status==='done'?'selected':'' %>>Fatti</option>
        </select>
      </label>
      <label class="text-xs font-semibold text-slate-600 md:col-span-3">Scadenza
        <select name="due" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full">
          <option value="">Tutte</option>
          <option value="overdue" <%= filters.due==='overdue'?'selected':'' %>>Scaduti</option>
          <option value="soon" <%= filters.due==='soon'?'selected':'' %>>Prossimi 3g</option>
        </select>
      </label>
      <label class="text-xs font-semibold text-slate-600 md:col-span-3">Tag
        <input name="tag" value="<%= filters.tag||'' %>" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full" placeholder="#tag">
      </label>
      <label class="text-xs font-semibold text-slate-600 md:col-span-3">Testo
        <input name="q" value="<%= filters.q||'' %>" class="mt-1 rounded border border-slate-200 px-2 py-2 text-sm w-full" placeholder="Cerca...">
      </label>
      <div class="md:col-span-12 flex justify-end">
        <button class="px-3 py-2 rounded bg-ink text-white text-sm w-full sm:w-auto">Filtra</button>
      </div>
    </form>
  </div>

  <% if (todos.length === 0) { %>
    <p class="text-slate-500 text-sm">Nessun task con questi filtri. Aggiungi un nuovo task o rimuovi i filtri.</p>
  <% } else { %>
    <div class="space-y-3">
      <% todos.forEach(t => { %>
        <article id="todo-<%= t.id %>" class="border border-slate-200 rounded-lg p-3">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
            <div class="flex items-center gap-3">
              <form action="/todos/<%= t.id %>/status" method="post">
                <input type="hidden" name="status" value="<%= t.status === 'done' ? 'todo' : 'done' %>">
                <button class="w-6 h-6 border rounded <%= t.status==='done' ? 'bg-emerald-500 border-emerald-500' : 'border-slate-300' %>" aria-label="Toggle stato"></button>
              </form>
              <div>
                <p class="font-semibold <%= t.status==='done' ? 'line-through text-slate-500' : '' %>"><%= t.title %></p>
                <p class="text-xs text-slate-500">Scadenza: <%= t.due_date ? new Date(t.due_date).toLocaleString() : '—' %></p>
              </div>
            </div>
            <div class="flex items-center gap-2 text-xs">
              <form action="/todos/<%= t.id %>/priority" method="post">
                <input type="hidden" name="priority" value="<%= t.priority === 'high' ? 'med' : t.priority === 'med' ? 'low' : 'high' %>">
                <button class="px-3 py-2 rounded border text-slate-700">Priorità: <%= t.priority %></button>
              </form>
              <span class="px-2 py-1 rounded bg-slate-100 capitalize"><%= t.status %></span>
            </div>
          </div>

          <details class="mt-2 text-sm text-slate-700">
            <summary class="cursor-pointer text-slate-600 py-1">Dettagli</summary>
            <div class="mt-2 space-y-2">
              <p class="whitespace-pre-line"><%= t.description || '—' %></p>
              <p class="text-xs text-slate-500">Tag: <%= t.tags || '—' %></p>
              <form action="/todos/<%= t.id %>/update" method="post" class="grid md:grid-cols-2 gap-2 bg-slate-50 border border-slate-200 rounded p-3">
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-600">Titolo</label>
                  <input name="title" value="<%= t.title %>" class="rounded border border-slate-200 px-2 py-2" required>
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-600">Scadenza</label>
                  <input name="due_date" type="datetime-local" value="<%= t.due_date ? new Date(t.due_date).toISOString().slice(0,16) : '' %>" class="rounded border border-slate-200 px-2 py-2">
                </div>
                <div class="flex flex-col gap-1 md:col-span-2">
                  <label class="text-xs font-semibold text-slate-600">Descrizione</label>
                  <textarea name="description" rows="2" class="rounded border border-slate-200 px-2 py-2"><%= t.description || '' %></textarea>
                </div>
                <div class="flex gap-2 items-center flex-col sm:flex-row">
                  <div class="flex flex-col gap-1 w-full sm:w-1/2">
                    <label class="text-xs font-semibold text-slate-600">Priorità</label>
                    <select name="priority" class="rounded border border-slate-200 px-2 py-2">
                      <option value="high" <%= t.priority==='high'?'selected':'' %>>Alta</option>
                      <option value="med" <%= t.priority==='med'?'selected':'' %>>Media</option>
                      <option value="low" <%= t.priority==='low'?'selected':'' %>>Bassa</option>
                    </select>
                  </div>
                  <div class="flex flex-col gap-1 w-full sm:w-1/2">
                    <label class="text-xs font-semibold text-slate-600">Stato</label>
                    <select name="status" class="rounded border border-slate-200 px-2 py-2">
                      <option value="todo" <%= t.status==='todo'?'selected':'' %>>Da fare</option>
                      <option value="doing" <%= t.status==='doing'?'selected':'' %>>In corso</option>
                      <option value="done" <%= t.status==='done'?'selected':'' %>>Fatto</option>
                    </select>
                  </div>
                </div>
                <div class="flex flex-col gap-1">
                  <label class="text-xs font-semibold text-slate-600">Tag</label>
                  <input name="tags" value="<%= t.tags || '' %>" class="rounded border border-slate-200 px-2 py-2" placeholder="#tag">
                </div>
                <div class="md:col-span-2 flex flex-col sm:flex-row gap-2 sm:justify-between">
                  <button class="px-3 py-2 rounded bg-ink text-white w-full sm:w-auto">Aggiorna</button>
                  <button formaction="/todos/<%= t.id %>/delete" formmethod="post" class="px-3 py-2 rounded bg-red-50 text-red-700 border border-red-200 w-full sm:w-auto" onclick="return confirm('Eliminare?')">Elimina</button>
                </div>
              </form>
            </div>
          </details>
        </article>
      <% }) %>
    </div>
  <% } %>

  <% if (recurringToday && recurringToday.length) { %>
    <hr class="my-4">
    <h3 class="font-semibold mb-2">Ricorrenti di oggi</h3>
    <div class="space-y-3">
      <% recurringToday.forEach(s => { const occ = occurrencesToday.filter(o => o.schedule_id === s.id) %>
        <article class="border border-slate-200 rounded-lg p-3">
          <div class="flex flex-col gap-1 md:flex-row md:items-center md:justify-between">
            <div>
              <p class="font-semibold"><%= s.title %></p>
              <p class="text-xs text-slate-500">Oggi: <%= s.done_slots %>/<%= s.total_slots %> · Giorni: <%= s.days_done %>/<%= s.total_days %></p>
            </div>
          </div>
          <div class="flex flex-wrap gap-2 mt-2">
            <% occ.forEach(o => { %>
              <form action="/todos/occurrence/<%= o.id %>/toggle" method="post">
                <button class="px-3 py-2 rounded border text-sm <%= o.status==='done' ? 'bg-emerald-100 border-emerald-400 text-emerald-800' : 'bg-white border-slate-200 text-slate-700' %>">
                  <%= o.slot_time %>
                </button>
              </form>
            <% }) %>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<%- include('partials/layout-end') %>
